OPENAI_API_KEY=
# Optional AWS secret containing an OPENAI_API_KEY field; requires AWS CLI credentials.
OPENAI_SECRET_ID=
AWS_REGION=us-east-1
OPENAI_MODEL=gpt-6-astra
# Choose novita, openai, or local (explicit rule demo).
SOCIETY_LLM_PROVIDER=novita
NOVITA_MODEL=deepseek/deepseek-v4-pro-0813
NOVITA_API_KEY=
NOVITA_SECRET_ID=
# JSON field in the configured AWS secret; use api_key if that is its stored field.
NOVITA_SECRET_FIELD=NOVITA_API_KEY
SOCIETY_DB_PATH=.data/society.db
SOCIETY_AGENT_COUNT=12
SOCIETY_SCENARIO=sf
SOCIETY_SEED=17
SOCIETY_MAX_CONCURRENT_LLM_CALLS=4
# Safe defaults: startup does not spend money. Opt in only after choosing a budget.
SOCIETY_START_PAUSED=1
SOCIETY_ALLOW_PAID_CALLS=0
SOCIETY_REQUEST_LIMIT=24
SOCIETY_LATENCY_AWARE=1
